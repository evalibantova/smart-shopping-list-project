{
  "name": "meal-planner/api",
  "description": "REST API for the meal planner",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "illuminate/database": "^10.0"
  },
  "require-dev": {
    "robmorgan/phinx": "^0.16"
  },
  "autoload": {
    "psr-4": { "MealPlanner\\Api\\": "src/" }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": { "php": "8.1.0" }
  }
}
