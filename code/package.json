{
  "name": "meal-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint src",
    "api": "php -S localhost:8080 -t public public/api/router.php",
    "api:install": "composer install --working-dir=public/api",
    "api:migrate": "php public/api/vendor/bin/phinx migrate -c public/api/phinx.php",
    "api:seed": "php public/api/vendor/bin/phinx seed:run -c public/api/phinx.php",
    "api:reset": "php public/api/vendor/bin/phinx rollback -c public/api/phinx.php -t 0 && npm run api:migrate && npm run api:seed",
    "api:sql": "$(command -v mariadb-dump || command -v mysqldump) -h127.0.0.1 -umeal_planner -pmeal_planner --no-tablespaces --skip-comments --ignore-table=meal_planner.phinxlog meal_planner > schema.sql",
    "test:php":"php phpunit.phar"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
